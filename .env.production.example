# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# SpriteDex authentication (never commit real values)
SPRITEDEX_JWT_SECRET=generate-with-openssl-rand-hex-32
SPRITEDEX_TOKEN_ENCRYPTION_KEY=generate-with-python-cryptography-fernet

# Durable encounter media
SPRITEDEX_MEDIA_PROVIDER=supabase
SPRITEDEX_MEDIA_BUCKET=encounter-media
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-credential

# App / proxy
SPRITEDEX_APP_URL=https://your-spritedex-host.example
SPRITEDEX_TRUST_PROXY_HEADERS=true
SPRITEDEX_REQUESTS_PER_MINUTE=180
LOG_LEVEL=INFO

# iNaturalist OAuth — add after the application is registered
INAT_CLIENT_ID=
INAT_CLIENT_SECRET=
INAT_REDIRECT_URI=https://your-spritedex-host.example/api/inaturalist/callback

# Manual encrypted database backups
SPRITEDEX_BACKUP_PASSPHRASE=use-a-long-random-secret
SPRITEDEX_BACKUP_DIR=backups
